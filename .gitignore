# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv311/
.venv*/
venv/
env/
.cache/
.runtime/
build/
dist/
*.egg-info/
.eggs/

# Generated outputs
*.parquet
*.npz
*.pkl
*.pickle
*.ckpt
*.onnx
*.pth
*.pt
*.safetensors
checkpoints/
results/*
!results/.gitkeep
tmp/
ppt/
data/processed/
artifacts/*
!artifacts/sustaincluster_imitation/
artifacts/sustaincluster_imitation/*
!artifacts/sustaincluster_imitation/README.md
!artifacts/sustaincluster_imitation/bc_actor_seed_11.pt

# 报告源文件保留，批量实验数据和渲染中间产物不进入 Git。
reports/**/*.csv
reports/**/*.json
reports/**/*.parquet
reports/**/*.pdf
reports/**/*.tex
reports/**/*.aux
reports/**/*.log
reports/sustaincluster_deployment/

# Data policy: keep only small samples in Git.
data/raw/
data/workload/
data/weather/
data/electricity_price/
data/carbon/
data/renewable/
data/db/*
!data/db/.gitkeep
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# External reference repositories are read-only references, not mainline code.
references/external_repos/*
!references/external_repos/.gitkeep
!references/external_repos/README.md

# Local environment
.env
.env.*

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
~$*
